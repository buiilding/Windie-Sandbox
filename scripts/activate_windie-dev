#!/usr/bin/env bash
# Source this file to expose the repository development binary in the current
# shell. Executing it cannot modify the parent shell's PATH.

if [[ "${BASH_SOURCE[0]:-}" == "${0}" ]]; then
  echo "source this file: source ./scripts/activate_windie-dev" >&2
  exit 1
fi

# `$0` names the caller when this file is sourced. Resolve the sourced file
# explicitly so the script works from both Bash and zsh.
if [[ -n "${BASH_SOURCE:-}" ]]; then
  windie_dev_script_path="${BASH_SOURCE[0]}"
elif [[ -n "${ZSH_VERSION:-}" ]]; then
  windie_dev_script_path="${funcsourcetrace[1]%:*}"
else
  echo "unsupported shell; source this file from bash or zsh" >&2
  return 1
fi

windie_dev_root="$(cd "$(dirname "$windie_dev_script_path")/.." && pwd)"
if ! cargo build --release --manifest-path "$windie_dev_root/Cargo.toml" --bin windie-dev; then
  return 1
fi
export WINDIE_DEV_ROOT="$windie_dev_root"
export PATH="$windie_dev_root/target/release:$PATH"
echo "windie-dev active: $windie_dev_root/target/release/windie-dev"
