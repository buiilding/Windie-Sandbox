{
  "manifest_version": "0.4",
  "name": "awesome-mineflayer-mcp",
  "display_name": "Awesome Mineflayer MCP",
  "version": "1.3.2",
  "description": "Control a Mineflayer Minecraft bot through MCP.",
  "author": {
    "name": "Ryker Geesaman",
    "url": "https://github.com/G0Osey99/awesome-mineflayer-mcp"
  },
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"]
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "node": ">=20"
    }
  }
}
